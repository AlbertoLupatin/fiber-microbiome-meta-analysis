# phyloseq preparation
class(NiY_combined) <- "numeric"
OTU_NiY <- otu_table(NiY_combined, taxa_are_rows = T)
TAX_NiY <- tax_table(NiY_taxonomy)
taxa_names(OTU_NiY) <- gsub("k__", "", taxa_names(OTU_NiY))
taxa_names(TAX_NiY) <- gsub("k__", "", taxa_names(TAX_NiY))
NiY_tax_ps <- phyloseq(OTU_NiY, TAX_NiY, sample_names(NiY_meta_bef_aft))
# Make a phyloseq object with unassigned counts removed for diversity analyses
NiY_tax_ps@OTU_NiY_table <- NiY_tax_ps@OTU_NiY_table[rownames(NiY_tax_ps@OTU_NiY_table) != "unassigned", ]
# Make a phyloseq object with unassigned counts removed for diversity analyses
NiY_tax_ps@otu_table <- NiY_tax_ps@otu_table[rownames(NiY_tax_ps@OTU_NiY_table) != "unassigned", ]
# Make a phyloseq object with unassigned counts removed for diversity analyses
NiY_tax_ps@otu_table <- NiY_tax_ps@otu_table[rownames(NiY_tax_ps@otu_table) != "unassigned", ]
# Make relative abundance phyloseq
NiY_tax_ps_rel <- microbiome::transform(NiY_tax_ps, "compositional")
NiY_tax_ps_rel@otu_table <- NiY_tax_ps_rel@otu[rownames(NiY_tax_ps_rel@otu_table) != "unassigned", ]
