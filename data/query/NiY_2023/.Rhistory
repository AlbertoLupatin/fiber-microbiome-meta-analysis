library(tidyverse)
library(SIAMCAT)
setwd("/Users/albertolupatin/Desktop/Internship/QueryFiltered/7_WastykHC")
# Chunk 2: setup
Wastyk_meta <- read.csv("Wastyk_2021_SraRunTable.csv")
Wastyk_meta2 <- Wastyk_meta |>
filter(Assay.Type == "WGS") |>
separate(Sample.Name, sep = "_", into = c("tmp1", "SampleID", "Timepoint", "tmp2")) |>
select(Library.Name, host_diet, Timepoint) |>
filter(!grepl("^P", Library.Name)) |>
column_to_rownames("Library.Name")
head(Wastyk_meta2)
# Chunk 3
Wastyk <- readRDS("Wastyk_2021_res_mOTUs.rds")
# obtain genus level raw counts
Wastyk_df<- Wastyk %>%
as.data.frame() %>%
rownames_to_column('taxon') %>%
pivot_longer(-taxon) %>%
group_by(name) %>%
mutate(motus = str_split_fixed(taxon, '\\|', n = 8)[, 8]) %>%
mutate(motus= ifelse(taxon=='unassigned','unassigned',motus)) %>%
dplyr::rename(sampleID = name) %>%
group_by(sampleID, motus) %>%
filter(motus != '') %>%
pivot_wider(id_cols = motus, names_from = sampleID, values_from = value) %>%
column_to_rownames('motus')
# conversion to the relative abundance table
Wastyk_relab <-Wastyk_df%>% mutate(across(everything(), ~ . / sum(.)))
# check if the sum of every column = 1
all(round(colSums(Wastyk_relab), digits = 10) == 1)
# Chunk 4
Wastyk_label <- create.label(meta=Wastyk_meta2, label="host_diet",
case = "Fiber", control="Fermented")
# Chunk 5
sc.obj <- siamcat(feat=Wastyk_relab,
label=Wastyk_label,
meta=Wastyk_meta2)
# Chunk 6
sc.obj <- filter.features(sc.obj)
# Chunk 7
sc.obj <- check.associations(sc.obj)
association.plot(sc.obj, panels = c("fc", "auroc", "prevalence"), fn.plot = "Associations.pdf")
check.confounders(sc.obj, fn.plot = "Confounders.pdf")
sc.obj <- normalize.features(sc.obj, norm.method = "rank.unit")
sc.obj <- create.data.split(sc.obj, num.folds = 5, num.resample = 2)
sc.obj <- train.model(sc.obj, method = "lasso")
model_type(sc.obj)
models <- models(sc.obj)
models[[1]]$model
sc.obj <- make.predictions(sc.obj)
predictions <- pred_matrix(sc.obj)
head(predictions)
sc.obj <- evaluate.predictions(sc.obj)
model.evaluation.plot(sc.obj, fn.plot = "Predictions.pdf")
sc.obj <- evaluate.predictions(sc.obj)
model.evaluation.plot(sc.obj, fn.plot = "Plots/Predictions.pdf")
sc.obj <- check.associations(sc.obj)
association.plot(sc.obj, panels = c("fc", "auroc", "prevalence"), fn.plot = "Plots/Associations.pdf")
model.interpretation.plot(sc.obj, fn = "Plots/Interpretation.pdf",
consens.thres = 0.5, limitis = c(-3, 3), heatmap.type = "zscore")
model.interpretation.plot(sc.obj, fn = "Plots/Interpretation.pdf")
library(tidyverse)
library(SIAMCAT)
