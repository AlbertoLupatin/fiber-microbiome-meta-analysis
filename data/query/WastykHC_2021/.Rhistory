NiY_meta <- read.csv("/Users/albertolupatin/Desktop/Internship/Query/17_NiY/NiY_2023_SraRunTable.csv") %>%
as.data.frame() %>%
separate(Filename, sep = "V", remove = F, into = c("tmp", "Timepoint")) %>%
separate(tmp, sep = "(?<=S)", into = c("Intervention", "Sample")) %>%
group_by(Sample) %>%
filter(n() == 2) %>%
ungroup() %>%
mutate(Timepoint = as.numeric(Timepoint)) %>%
select(Run, Sample, Intervention, Timepoint)
rownames(NiY_meta) <- NiY_meta$Run
NiY_meta_bef_aft <- NiY_meta %>% filter((Timepoint == 1 | Timepoint == 5) & Intervention == "RS")
NiY <- readRDS("/Users/albertolupatin/Desktop/Internship/Query/17_NiY/res_mOTUs.rds") %>%
as.data.frame() %>%
rownames_to_column("taxon") %>%
pivot_longer(-taxon) %>%
rename(Run = name, Counts = value)
NiY_CpS <- NiY %>%
group_by(Run) %>%
summarize(counts_sum = sum(Counts))
NiY_combined <- NiY %>%
group_by(taxon, Run) %>% # groups by sample
mutate(Counts = sum(Counts)) %>% # count the total number of counts per sample
ungroup() %>%
distinct() %>% # keep only unique rows
pivot_wider(names_from = Run, values_from = Counts) %>%
column_to_rownames("taxon") %>%
as.matrix()
NiY_combined <- NiY_combined[, colnames(NiY_combined) %in% rownames(NiY_meta_bef_aft)]
# NiY_taxonomy table
unassigned_cat <- t(as.data.frame(rep(c("unassigned"), each = 8))) %>% # 1 row, 8 column NiYframe
as.data.frame() %>%
dplyr::rename(Kingdom = 1, Phylum = 2, Class = 3 , Order = 4, Family = 5, Genus = 6, Species = 7, mOTU_number = 8)
NiY_taxonomy <- as.data.frame(rownames(NiY_combined)) %>%
rename("Full_NiY_taxonomy" =  1) %>% # NiYframe contains only taxonomies
filter(Full_NiY_taxonomy != "unassigned") %>%
separate_wider_delim(Full_NiY_taxonomy, "|", names = c("Kingdom", "Phylum", "Class", "Order", "Family", "Genus", "Species", "mOTU_number")) %>%
add_row(unassigned_cat) %>%
mutate(full_mOTUs_name = rownames(NiY_combined)) %>%
column_to_rownames(var = "full_mOTUs_name") %>%
as.matrix()
# phyloseq preparation
class(NiY_combined) <- "numeric"
OTU_NiY <- otu_table(NiY_combined, taxa_are_rows = T)
TAX_NiY <- tax_table(NiY_taxonomy)
taxa_names(OTU_NiY) <- gsub("k__", "", taxa_names(OTU_NiY))
taxa_names(TAX_NiY) <- gsub("k__", "", taxa_names(TAX_NiY))
NiY_tax_ps <- phyloseq(OTU_NiY, TAX_NiY, sample_names(NiY_meta_bef_aft))
# Make a phyloseq object with unassigned counts removed for diversity analyses
NiY_tax_ps@otu_table <- NiY_tax_ps@otu_table[rownames(NiY_tax_ps@otu_table) != "unassigned", ]
# Make relative abundance phyloseq
NiY_tax_ps_rel <- microbiome::transform(NiY_tax_ps, "compositional")
NiY_tax_ps_rel@otu_table <- NiY_tax_ps_rel@otu_table[rownames(NiY_tax_ps_rel@otu_table) != "unassigned", ]
View(Wastyk_tax_ps_rel)
