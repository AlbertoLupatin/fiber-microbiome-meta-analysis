library(tidyverse)
library(ggplot2)
library(ggpubr)
library(phyloseq)
library(microbiome)
library(microViz)
library(envalysis)
library(lme4)
setwd("/Users/albertolupatin/Desktop/Internship/Query/17_NiY")
meta <- read.csv("NiY_2023_SraRunTable.csv") %>%
as.data.frame() %>%
separate(Filename, sep = "V", remove = F, into = c("sampleID", "Timepoint")) %>%
separate(sampleID, sep = "(?<=S)", into = c("Intervention", "sample")) %>%
mutate(Timepoint = as.factor(Timepoint)) %>%
mutate(sample = as.integer(sample)) %>%
group_by(sample) %>%
add_count() %>%
filter(n == 2) %>%
ungroup() %>%
column_to_rownames("Run")%>%
select(Filename, sample, Intervention, Timepoint) %>%
rename(sampleID = Filename) %>%
arrange(sample, Timepoint)
data <- readRDS("res_mOTUs.rds") %>%
as.data.frame() %>%
rownames_to_column("taxon") %>%
pivot_longer(-taxon) %>%
rename(sampleID = name, Counts = value)
CpS <- data %>%
group_by(sampleID) %>%
summarize(counts_sum = sum(Counts))
combined <- data %>%
group_by(taxon, sampleID) %>% # groups by sample
mutate(Counts = sum(Counts)) %>% # count the total number of counts per sample
ungroup() %>%
distinct() %>% # keep only unique rows
pivot_wider(names_from = sampleID, values_from = Counts) %>%
column_to_rownames("taxon") %>%
as.matrix()
combined <- combined[, colnames(combined) %in% rownames(meta)]
# Taxonomy table
unassigned_cat <- t(as.data.frame(rep(c("unassigned"), each = 8))) %>% # 1 row, 8 column dataframe
as.data.frame() %>%
dplyr::rename(Kingdom = 1, Phylum = 2, Class = 3 , Order = 4, Family = 5, Genus = 6, Species = 7, mOTU_number = 8)
taxonomy <- as.data.frame(rownames(combined)) %>%
rename("Full_taxonomy" =  1) %>% # dataframe contains only taxonomies
filter(Full_taxonomy != "unassigned") %>%
separate_wider_delim(Full_taxonomy, "|", names = c("Kingdom", "Phylum", "Class", "Order", "Family", "Genus", "Species", "mOTU_number")) %>% # divide
add_row(unassigned_cat) %>%
mutate(full_mOTUs_name = rownames(combined)) %>%
column_to_rownames(var = "full_mOTUs_name") %>%
as.matrix()
# phyloseq preparation
class(combined) <- "numeric"
OTU <- otu_table(combined, taxa_are_rows = T)
TAX <- tax_table(taxonomy)
taxa_names(OTU) <- gsub("k__", "", taxa_names(OTU))
taxa_names(TAX) <- gsub("k__", "", taxa_names(TAX))
tax_ps <- phyloseq(OTU, TAX, sample_data(meta)) # sample_data to convert metadata into phyloseq's format
# Make a phyloseq object with unassigned counts removed for diversity analyses
tax_ps@otu_table <- tax_ps@otu_table[rownames(tax_ps@otu_table) != "unassigned", ]
# Make relative abundance phyloseq
tax_ps_rel <- microbiome::transform(tax_ps, "compositional")
tax_ps_rel@otu_table <- tax_ps_rel@otu_table[rownames(tax_ps_rel@otu_table) != "unassigned", ]
tax_ps_rel@tax_table <- tax_ps_rel@tax_table[rownames(tax_ps_rel@tax_table) != "unassigned", ]
library(SIAMCAT)
tax_ps_rel_rs <- tax_ps_rel %>% ps_filter(Intervention == "RS")
label <- create.label(meta = sample_data(tax_ps_rel_rs), label = "Timepoint", case = 5)
sc <- siamcat(phyloseq = tax_ps_rel_rs, label = label)
show(sc)
sc <- filter.features(sc, cutoff = 0.001, verbose = 2)
sc <- normalize.features(sc, norm.method = "log.std", verbose = 2)
sc <- check.associations(sc, formula = "feat~label", test = "lm", feature.type = "normalized", alpha = 0.5, verbose = 2)
association.plot(sc, "Plots/Association.pdf")
sc_associations <- associations(sc)
View(sc)
View(sc@phyloseq@sam_data)
tax_ps_rel_rs <- tax_ps_rel %>% ps_filter(Intervention == "RS")
label <- create.label(meta = sample_data(tax_ps_rel_rs), label = "Timepoint", case = 5)
sc <- siamcat(phyloseq = tax_ps_rel_rs, label = label)
show(sc)
sc <- filter.features(sc, cutoff = 0.001, verbose = 2)
sc <- normalize.features(sc, norm.method = "log.std", verbose = 2)
sc <- check.associations(sc, formula = "feat~label+(1|sampleID)", test = "lm", feature.type = "normalized", alpha = 0.5, verbose = 2)
pcoa <- ordinate(tax_ps_rel, method='PCoA', distance = 'bray')
arrows <- plt %>%
select(sample, Timepoint, Axis.1, Axis.2, Intervention) %>%
pivot_wider(names_from = Timepoint, values_from = c(Axis.1, Axis.2), names_prefix = "T") #%>%
plt <- plot_ordination(tax_ps_rel, pcoa, color="Timepoint", justDF = TRUE)
arrows <- plt %>%
select(sample, Timepoint, Axis.1, Axis.2, Intervention) %>%
pivot_wider(names_from = Timepoint, values_from = c(Axis.1, Axis.2), names_prefix = "T") #%>%
View(arrows)
