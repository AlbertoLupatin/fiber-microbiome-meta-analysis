Wastyk_combined <- Wastyk %>%
group_by(taxon, Run) %>%
mutate(Counts = sum(Counts)) %>%
ungroup() %>%
distinct() %>%
pivot_wider(names_from = Run, values_from = Counts) %>%
column_to_rownames("taxon") %>%
as.matrix()
Wastyk_combined <- Wastyk_combined[, colnames(Wastyk_combined) %in% rownames(Wastyk_meta_bef_aft)]
unassigned_cat <- t(as.data.frame(rep(c("unassigned"), each = 8))) %>%
as.data.frame() %>%
dplyr::rename(Kingdom = 1, Phylum = 2, Class = 3 , Order = 4, Family = 5, Genus = 6, Species = 7, mOTU_number = 8)
Wastyk_taxonomy <- as.data.frame(rownames(Wastyk_combined)) %>%
rename("Full_taxonomy" =  1) %>%
filter(Full_taxonomy != "unassigned") %>%
